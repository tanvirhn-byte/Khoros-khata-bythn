# ==============================================================================
# Khoroch er Khata (খরচের খাতা) — Production cPanel / Apache / LiteSpeed Config
# ==============================================================================

# 1. Disable directory browsing
Options -Indexes

# 2. Ensure UTF-8 default charset and correct Web App Manifest MIME type
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .json .webmanifest
</IfModule>

# 3. Preserve Authorization: Bearer header under cPanel PHP-FPM / FastCGI / LiteSpeed
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Block direct HTTP access to the data/ directory and its contents
  RewriteRule ^data(/|$) - [F,L]

  # Optional: Force HTTPS in Production (Uncomment on cPanel if AutoSSL redirect is not enabled)
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 4. Block direct HTTP access to SQLite databases, WAL/SHM journals, backups, and log files
<FilesMatch "\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|db|log|bak|sql|ini|sh|py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5. Baseline Security Headers for static files
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^(sw\.js|index\.html|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg|webp)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
</IfModule>

# 6. Enable Gzip/Deflate Compression for faster mobile loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
